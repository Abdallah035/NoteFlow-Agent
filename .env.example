# Copy this file to .env and put your own key in it.
# .env is in .gitignore, so it never reaches git.

# Required. Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_key_here
NOTEFLOW_EMBEDDINGS=1
# Optional. Any Gemma or Gemini model that supports tools.
# NOTEFLOW_MODEL=gemma-4-31b-it

# Optional. Set to 1 to turn on semantic search.
# Needs: uv sync --extra embeddings
# NOTEFLOW_EMBEDDINGS=1
